{
	"$schema": "https://json.schemastore.org/package.json",
	"version": "0.1.0",
	"project": "poke-liquid-dex",
	"name": "poke-liquid-dex",
	"title": "Poke Liquid Dex",
	"description": "Galería de Pokémon con buscador, detalle, comparador y estética liquid glass, sobre la PokeAPI.",
	"scripts": {
		"start": "env -e main -m debug --log debug : vite",
		"build": "env -e main -m build --log debug : vite build",
		"preview": "pnpm build && env -e main -m build : vite preview",
		"test": "env -e main -m test : vitest",
		"test:mutation": "env -e main -m test : stryker run",
		"env:schema": "env schema -e main -m build",
		"lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
		"stylelint": "stylelint --cache src/**/*.css --cache-location node_modules/.cache/stylelint/",
		"format": "prettier --cache --write **/*.{ts,cts,mts,tsx,css,json,html,md,yml,yaml,webmanifest}",
		"clean": "pnpx del-cli dist reports **/*.tsbuildinfo .node_modules"
	},
	"imports": {
		"#libs/ioc": "./src/libs/ioc/ioc.builder.tsx",
		"#libs/router": "./src/libs/router/index.ts",
		"#libs/feature": "./src/libs/feature/index.ts",
		"#libs/cache": "./src/libs/cache/index.ts"
	},
	"dependencies": {
		"jotai": "2.20.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-router": "7.16.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@calvear/env": "3.1.0",
		"@iconify-json/mdi": "1.2.3",
		"@stryker-mutator/core": "9.6.1",
		"@stryker-mutator/typescript-checker": "9.6.1",
		"@stryker-mutator/vitest-runner": "9.6.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/eslint": "9.6.1",
		"@types/node": "25.9.1",
		"@types/react": "19.2.16",
		"@types/react-dom": "19.2.3",
		"@unocss/eslint-config": "66.7.0",
		"@vitejs/plugin-react": "6.0.2",
		"@vitest/coverage-v8": "4.1.8",
		"@vitest/eslint-plugin": "1.6.19",
		"eslint": "10.4.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jest-dom": "5.5.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-perfectionist": "5.9.0",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-promise": "7.3.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-regexp": "3.1.0",
		"eslint-plugin-sonarjs": "4.0.3",
		"eslint-plugin-testing-library": "7.16.2",
		"eslint-plugin-unicorn": "64.0.0",
		"globals": "17.6.0",
		"happy-dom": "20.9.0",
		"postcss": "8.5.15",
		"prettier": "3.8.3",
		"stylelint": "17.12.0",
		"stylelint-config-rational-order": "0.1.2",
		"stylelint-config-recommended": "18.0.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-order": "8.1.1",
		"stylelint-prettier": "5.0.3",
		"stylelint-use-nesting": "6.0.2",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.1",
		"unocss": "66.7.0",
		"vite": "8.0.16",
		"vite-plugin-pwa": "1.3.0",
		"vite-plugin-webfont-dl": "3.12.0",
		"vitest": "4.1.8",
		"vitest-mock-extended": "4.0.0"
	},
	"type": "module",
	"engines": {
		"node": ">=24",
		"npm": ">=11",
		"pnpm": ">=11"
	},
	"license": "MIT",
	"keywords": [
		"react",
		"pokeapi",
		"pokedex",
		"vite",
		"vitest",
		"typescript",
		"jotai",
		"spa",
		"pwa",
		"unocss"
	]
}
