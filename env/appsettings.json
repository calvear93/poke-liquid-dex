{
	"$schema": "../node_modules/@calvear/env/schemas/env.schema.json",
	"|DEFAULT|": {
		"BASE_URL": "/",
		"FONT_FAMILY": "Manrope",
		"FONT_WEIGHTS": "400..800",
		"SERVICE_WORKER": true,
		"APP": {
			"ENV": "[[ENV]]",
			"NAME": "Poke Liquid Dex",
			"VERSION": "[[VERSION]]",
			"NO_SCRIPT": "Necesitas habilitar JavaScript para usar esta app.",
			"API_URL": "https://pokeapi.co/api/v2",
			"ARTWORK_URL": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork",
			"SPRITE_URL": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon",
			"CRIES_URL": "https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest",
			"MAX_DEX": 1025,
			"CACHE_VERSION": "v1"
		}
	},
	"|MODE|": {
		"build": {
			"NODE_ENV": "production",
			"BASE_URL": "/"
		},
		"debug": {
			"NODE_ENV": "development",
			"PORT": 3003
		},
		"test": {
			"NODE_ENV": "test"
		}
	},
	"|ENV|": {
		"main": {}
	},
	"|LOCAL|": {
		"main": {}
	}
}
